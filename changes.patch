index 0000000000000000000000000000000000000000..ed51bccdeecc3af099e216ebc00895aa05032087
--- /dev/null
+++ b/scripts/apply_patch.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Apply a git patch with whitespace cleanup and helpful diagnostics.
+
+This helper is intended for contributors on Windows/PowerShell or for patches
+that may already be applied to the current branch. It avoids the common failure
+mode where `git apply --check changes.patch` reports trailing whitespace and a
+hunk that no longer applies because the branch already contains those changes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+def _run(command: list[str]) -> subprocess.CompletedProcess[str]:
+    """Run a command and capture text output."""
+    return subprocess.run(command, capture_output=True, text=True, check=False)
+
+
+def _strip_trailing_whitespace_from_patch(patch_text: str) -> str:
+    """Remove trailing whitespace from patch lines without altering newlines."""
+    normalized_lines: list[str] = []
+    for line in patch_text.splitlines(keepends=True):
+        newline = ""
+        body = line
+        if line.endswith("\r\n"):
+            body = line[:-2]
+            newline = "\r\n"
+        elif line.endswith("\n"):
+            body = line[:-1]
+            newline = "\n"
+        normalized_lines.append(f"{body.rstrip()}" + newline)
+    return "".join(normalized_lines)
+
+
+def _print_process(process: subprocess.CompletedProcess[str]) -> None:
+    """Print captured subprocess output."""
+    if process.stdout:
+        print(process.stdout, end="")
+    if process.stderr:
+        print(process.stderr, end="", file=sys.stderr)
+
+
+def _write_normalized_patch(patch_path: Path) -> Path | None:
+    """Write a whitespace-normalized temporary patch and return its path."""
+    if not patch_path.exists():
+        print(f"Patch file not found: {patch_path}", file=sys.stderr)
+        return None
+
+    patch_text = patch_path.read_text(encoding="utf-8")
+    normalized_patch = _strip_trailing_whitespace_from_patch(patch_text)
+
+    with tempfile.NamedTemporaryFile(
+        "w",
+        encoding="utf-8",
+        newline="",
+        suffix=".patch",
+        delete=False,
+    ) as patch_file:
+        patch_file.write(normalized_patch)
+        return Path(patch_file.name)
+
+
+def check_patch(patch_path: Path) -> int:
+    """Check whether a patch can apply or is already applied."""
+    normalized_path = _write_normalized_patch(patch_path)
+    if normalized_path is None:
+        return 2
+
+    try:
+        check = _run(["git", "apply", "--check", "--whitespace=fix", str(normalized_path)])
+        if check.returncode == 0:
+            print("Patch can be applied cleanly.")
+            return 0
+
+        reverse_check = _run(["git", "apply", "--reverse", "--check", str(normalized_path)])
+        if reverse_check.returncode == 0:
+            print("Patch appears to be already applied to this branch.")
+            return 0
+
+        three_way_check = _run(
+            ["git", "apply", "--3way", "--check", "--whitespace=fix", str(normalized_path)]
+        )
+        if three_way_check.returncode == 0:
+            print("Patch can be applied with three-way merge fallback.")
+            return 0
+
+        print("Patch could not be applied cleanly.", file=sys.stderr)
+        print("Initial check output:", file=sys.stderr)
+        _print_process(check)
+        print("Three-way check output:", file=sys.stderr)
+        _print_process(three_way_check)
+        return three_way_check.returncode
+    finally:
+        normalized_path.unlink(missing_ok=True)
+
+
+def apply_patch(patch_path: Path) -> int:
+    """Apply a patch, returning a process-style exit code."""
+    normalized_path = _write_normalized_patch(patch_path)
+    if normalized_path is None:
+        return 2
+
+    try:
+        check = _run(["git", "apply", "--check", "--whitespace=fix", str(normalized_path)])
+        if check.returncode == 0:
+            applied = _run(["git", "apply", "--whitespace=fix", str(normalized_path)])
+            _print_process(applied)
+            return applied.returncode
+
+        reverse_check = _run(["git", "apply", "--reverse", "--check", str(normalized_path)])
+        if reverse_check.returncode == 0:
+            print("Patch appears to be already applied to this branch; no changes made.")
+            return 0
+
+        three_way = _run(["git", "apply", "--3way", "--whitespace=fix", str(normalized_path)])
+        if three_way.returncode == 0:
+            _print_process(three_way)
+            return 0
+
+        print("Patch could not be applied cleanly.", file=sys.stderr)
+        print("Initial check output:", file=sys.stderr)
+        _print_process(check)
+        print("Three-way apply output:", file=sys.stderr)
+        _print_process(three_way)
+        return three_way.returncode
+    finally:
+        normalized_path.unlink(missing_ok=True)
+
+
+def main() -> int:
+    """CLI entrypoint."""
+    parser = argparse.ArgumentParser(description="Apply a git patch safely.")
+    parser.add_argument(
+        "patch",
+        nargs="?",
+        default="changes.patch",
+        type=Path,
+        help="Patch file to apply (default: changes.patch)",
+    )
+    parser.add_argument(
+        "--check",
+        action="store_true",
+        help="Only check whether the patch can apply or is already applied",
+    )
+    args = parser.parse_args()
+    if args.check:
+        return check_patch(args.patch)
+    return apply_patch(args.patch)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
